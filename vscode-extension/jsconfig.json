{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "checkJs": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "extension.js"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}