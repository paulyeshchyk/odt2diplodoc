{
    // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
    // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
    // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Запуск конвертера",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/diplodoc_converter/cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "-odt_path",
                "../gs10_odt/manual.odt",
                "-output_dir",
                "../gs10_odt/docs",
                "--temp-dir",
                "../gs10_odt/.cache",
                "--lua-filter",
                "no-img-size.lua, fix-sequence-refs.lua"
            ]
        },
        {
            "name": "Python: Запуск конвертера (с кэшем)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/diplodoc_converter/cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "-odt_path",
                "../gs10_odt/manual.odt",
                "-output_dir",
                "../gs10_odt/docs",
                "--temp-dir",
                "../gs10_odt/.cache",
                "--lua-filter",
                "no-img-size.lua, fix-sequence-refs.lua",
                "--reuse-cache",
                "--keep-cache"
            ]
        }
    ]
}