{
    // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
    // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
    // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
            ]
        },
        {
            "name": "Python: Запуск конвертера",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fromODT/diplodoc_converter/cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "../gs10_odt/manual.odt",
                "../gs10_odt/docs/ru",
                "--temp-dir",
                "../gs10_odt/.cache",
                "--lua-filter",
                "no-img-size.lua, logging.lua",
                "--lua-dir",
                "./lua",
                "--enable-crossref",
                "--crossref-metadata-file",
                "crossref-config.yaml"
            ]
        },
        {
            "name": "Python: Запуск конвертера (с кэшем)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fromODT/diplodoc_converter/cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "../gs10_odt/manual.odt",
                "../gs10_odt/docs/ru",
                "--temp-dir",
                "../gs10_odt/.cache",
                "--lua-filter",
                "no-img-size.lua, logging.lua",
                "--lua-dir",
                "./lua",
                "--reuse-cache",
                "--keep-cache",
                "--enable-crossref",
            ]
        },
        {
            "name": "Python: MD -> ODT",
            "type": "debugpy",
            "request": "launch",
            "module": "diplodoc_converter.cli",
            "args": [
                "build",
                "-i",
                "C:\\projects\\ascon\\GULF_Help\\docs\\ru",
                "-o",
                "C:\\projects\\private\\gs10_odt\\calibr.odt",
                "--width-threshold",
                "700",
                "--reference",
                "C:\\projects\\private\\gs10_odt\\reference.odt"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: ODT -> MD",
            "type": "debugpy",
            "request": "launch",
            "module": "diplodoc_converter.cli",
            "args": [
                "import",
                "C:\\projects\\private\\gs10_odt\\calibr.odt",
                "C:\\projects\\private\\gs10_odt\\docs\\ru",
                "--enable-crossref",
                "--max-heading-level",
                "4",
                "--lua-filter",
                "no-img-size.lua, logging.lua, restore_notes.lua",
                "--lua-dir",
                "./lua",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}